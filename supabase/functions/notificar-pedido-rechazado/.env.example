# Mismas credenciales de Firebase que las otras funciones de push
# (notificar-cliente-pendiente / notificar-lista-espera / notificar-pedido-nuevo).
# Si ya están cargadas para alguna de esas, no hace falta hacer nada.
#
#   supabase secrets set FCM_PROJECT_ID= ...
#   supabase secrets set FCM_CLIENT_EMAIL= ...
#   supabase secrets set FCM_PRIVATE_KEY=" ... "

FCM_PROJECT_ID=mi-proyecto-firebase
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@mi-proyecto-firebase.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQ...\n-----END PRIVATE KEY-----\n"
